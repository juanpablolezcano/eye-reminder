<Window x:Class="EyeReminder.ColourPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="336" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF15171C"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Shows through the alpha slider and the preview so opacity is visible -->
        <DrawingBrush x:Key="Chequer" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3D45">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF272A31">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,5,5"/>
                                <RectangleGeometry Rect="5,5,5,5"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="CaretBrush" Value="#FF7FD4C4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="8" Background="#12FFFFFF"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#907FD4C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#DEFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="15,8"
                                Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#FF10231F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="20,8" Background="#FF7FD4C4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF95E0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Saturation across, brightness down, over the pure hue -->
        <Border CornerRadius="8" ClipToBounds="True">
            <Canvas x:Name="Field" Width="296" Height="170" Background="Transparent">
                <Rectangle x:Name="FieldHue" Width="296" Height="170"/>
                <Rectangle Width="296" Height="170">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="296" Height="170">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000"/>
                            <GradientStop Offset="1" Color="#FF000000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse x:Name="FieldThumb" Width="14" Height="14" IsHitTestVisible="False"
                         Stroke="#FFFFFFFF" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>

        <TextBlock x:Name="LblHue" Style="{StaticResource L}" Margin="0,16,0,5"/>
        <Border CornerRadius="7" ClipToBounds="True">
            <Canvas x:Name="HueBar" Width="296" Height="16" Background="Transparent">
                <Rectangle Width="296" Height="16">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.000" Color="#FFFF0000"/>
                            <GradientStop Offset="0.167" Color="#FFFFFF00"/>
                            <GradientStop Offset="0.333" Color="#FF00FF00"/>
                            <GradientStop Offset="0.500" Color="#FF00FFFF"/>
                            <GradientStop Offset="0.667" Color="#FF0000FF"/>
                            <GradientStop Offset="0.833" Color="#FFFF00FF"/>
                            <GradientStop Offset="1.000" Color="#FFFF0000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="HueThumb" Width="4" Height="16" Fill="#FFFFFFFF" IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <TextBlock x:Name="LblAlpha" Style="{StaticResource L}" Margin="0,14,0,5"/>
        <Border CornerRadius="7" ClipToBounds="True" Background="{StaticResource Chequer}">
            <Canvas x:Name="AlphaBar" Width="296" Height="16" Background="Transparent">
                <Rectangle x:Name="AlphaFill" Width="296" Height="16"/>
                <Rectangle x:Name="AlphaThumb" Width="4" Height="16" Fill="#FFFFFFFF" IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="HexInput" Grid.Column="0" Style="{StaticResource Box}"/>

            <Border Grid.Column="1" Width="46" Margin="10,0,0,0" CornerRadius="8"
                    Background="{StaticResource Chequer}" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border x:Name="Swatch" CornerRadius="7"/>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
            <Button x:Name="OkButton" Style="{StaticResource Primary}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
