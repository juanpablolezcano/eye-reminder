<Window x:Class="EyeReminder.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        Opacity="0">

    <Border x:Name="Card"
            Margin="28"
            CornerRadius="18"
            Padding="26,20,30,20"
            Background="#F0121418"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1">

        <Border.LayoutTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

            <!-- Eye mark: outer almond + iris -->
            <Grid Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,20,0">
                <Path x:Name="EyeOutline"
                      Stroke="#7FD4C4" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 3,22 C 11,10 33,10 41,22 C 33,34 11,34 3,22 Z"/>
                <Ellipse x:Name="EyePupil" Width="12" Height="12" Fill="#7FD4C4"/>
            </Grid>

            <StackPanel VerticalAlignment="Center" MinWidth="300">
                <TextBlock x:Name="TitleText"
                           Text="Descansá la vista"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"/>

                <TextBlock x:Name="MessageText"
                           Text="Mirá algo a 6 metros durante 20 segundos"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13.5"
                           Margin="0,3,0,12"
                           Foreground="#B4FFFFFF"/>

                <!-- Countdown track; the fill shrinks to zero over the break -->
                <Grid x:Name="ProgressRow">
                    <Border x:Name="ProgressTrack" Height="5" CornerRadius="3"
                            Background="#26FFFFFF" HorizontalAlignment="Stretch"/>
                    <Border x:Name="ProgressFill" Height="5" CornerRadius="3"
                            Background="#7FD4C4" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="CountdownText"
                       Text="20"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="34" FontWeight="Light"
                       Foreground="#E6FFFFFF"/>
        </StackPanel>
    </Border>
</Window>
