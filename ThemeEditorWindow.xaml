<Window x:Class="EyeReminder.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF15171C"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C8FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#7AFFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="CaretBrush" Value="#FF7FD4C4"/>
            <Setter Property="SelectionBrush" Value="#FF7FD4C4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="8" Background="#12FFFFFF"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#907FD4C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#DEFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="15,8"
                                Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter TargetName="B" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#FF10231F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="20,8" Background="#FF7FD4C4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF95E0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">

        <TextBlock x:Name="LblName" Style="{StaticResource L}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameInput" Style="{StaticResource Box}"/>

        <!-- Live preview: the same shapes the reminder card uses -->
        <Border x:Name="Preview" CornerRadius="14" Padding="18,14" BorderThickness="1" Margin="0,18,0,4">
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Path x:Name="PreviewEye" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 2,17 C 8.5,7.5 25.5,7.5 32,17 C 25.5,26.5 8.5,26.5 2,17 Z"/>
                    <Ellipse x:Name="PreviewPupil" Width="9" Height="9"/>
                </Grid>
                <StackPanel VerticalAlignment="Center" MinWidth="250">
                    <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PreviewMessage" FontSize="12" Margin="0,2,0,9"/>
                    <Grid>
                        <Border x:Name="PreviewTrack" Height="4" CornerRadius="2" HorizontalAlignment="Stretch"/>
                        <Border x:Name="PreviewFill" Height="4" CornerRadius="2"
                                HorizontalAlignment="Left" Width="150"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="PreviewCount" Text="20" VerticalAlignment="Center"
                           Margin="18,0,0,0" FontSize="26" FontWeight="Light"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintEditor" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

        <Grid x:Name="ColourRows" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        </Grid>

        <Grid Margin="0,22,0,0">
            <Button x:Name="DeleteButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Style="{StaticResource Primary}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
