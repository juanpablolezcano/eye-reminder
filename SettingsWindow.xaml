<Window x:Class="EyeReminder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeReminder — Configuración"
        Width="580" Height="740"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF15171C"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <!-- Section heading -->
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF7FD4C4"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C8FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Slider readout -->
        <Style x:Key="V" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#7AFFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Selectable chip: themes, accents, positions -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Foreground" Value="#B4FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="8" Padding="13,7"
                                Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#307FD4C4"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#907FD4C4"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="6"
                                    Background="#12FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 4.5,9.5 L 7.8,12.8 L 14,5.5"
                                      Stroke="#FF15171C" StrokeThickness="2.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF7FD4C4"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF7FD4C4"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="CaretBrush" Value="#FF7FD4C4"/>
            <Setter Property="SelectionBrush" Value="#FF7FD4C4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="8" Background="#12FFFFFF"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#907FD4C4"/>
                            </Trigger>
                            <!-- Greyed out while the language default is on show -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                <Setter TargetName="B" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider parts: the decrease half draws the filled portion of the track -->
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#FF7FD4C4" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Knob" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="15" Height="15" Fill="#FFFFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Slim" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Knob}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRest}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#DEFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="15,8"
                                Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#FF10231F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Padding="20,8" Background="#FF7FD4C4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF95E0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="26,4,26,10">
            <StackPanel>

                <TextBlock x:Name="SecReminder" Style="{StaticResource H}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblFrequency" Style="{StaticResource L}"/>
                    <Slider x:Name="IntervalSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="IntervalValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblBreak" Style="{StaticResource L}"/>
                    <Slider x:Name="BreakSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="5" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="BreakValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblCountdown" Style="{StaticResource L}"/>
                    <Slider x:Name="CountdownSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="CountdownValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>
                <TextBlock x:Name="HintCountdown" Style="{StaticResource Hint}"/>

                <CheckBox x:Name="StartupNoticeCheck" Style="{StaticResource Check}" Margin="0,14,0,0"/>

                <TextBlock x:Name="SecIdle" Style="{StaticResource H}"/>
                <CheckBox x:Name="IdleCheck" Style="{StaticResource Check}"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblPauseAfter" Style="{StaticResource L}"/>
                    <Slider x:Name="IdleSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="IdleValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>
                <TextBlock x:Name="HintIdle" Style="{StaticResource Hint}"/>

                <TextBlock x:Name="SecStyle" Style="{StaticResource H}"/>
                <WrapPanel x:Name="ThemePanel"/>

                <TextBlock x:Name="LblAccent" Style="{StaticResource L}" Margin="0,10,0,8"/>
                <WrapPanel x:Name="AccentPanel"/>

                <TextBlock x:Name="SecPosition" Style="{StaticResource H}"/>
                <WrapPanel x:Name="PositionPanel"/>
                <CheckBox x:Name="AllScreensCheck" Style="{StaticResource Check}" Margin="0,6,0,0"/>

                <Grid Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblSize" Style="{StaticResource L}"/>
                    <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="0.7" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblOpacity" Style="{StaticResource L}"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="0.2" Maximum="1.0" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>

                <TextBlock x:Name="SecLanguage" Style="{StaticResource H}"/>
                <WrapPanel x:Name="LanguagePanel"/>

                <TextBlock x:Name="SecTexts" Style="{StaticResource H}"/>
                <CheckBox x:Name="CustomTextCheck" Style="{StaticResource Check}"/>
                <TextBlock x:Name="HintCustomText" Style="{StaticResource Hint}" Margin="0,6,0,12"/>

                <TextBlock x:Name="LblTextTitle" Style="{StaticResource L}" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleInput" Style="{StaticResource Box}" Margin="0,0,0,12"/>
                <TextBlock x:Name="LblTextCountdown" Style="{StaticResource L}" Margin="0,0,0,6"/>
                <TextBox x:Name="CountdownInput" Style="{StaticResource Box}" Margin="0,0,0,12"/>
                <TextBlock x:Name="LblTextBreak" Style="{StaticResource L}" Margin="0,0,0,6"/>
                <TextBox x:Name="MessageInput" Style="{StaticResource Box}"/>

                <TextBlock x:Name="SecSound" Style="{StaticResource H}"/>
                <CheckBox x:Name="SoundCheck" Style="{StaticResource Check}"/>
                <CheckBox x:Name="SoundFinishCheck" Style="{StaticResource Check}" Margin="0,10,0,0"/>

                <Grid Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblVolume" Style="{StaticResource L}"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource Slim}"
                            Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="VolumeValue" Grid.Column="2" Style="{StaticResource V}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SoundFileBox" Grid.Column="0" Style="{StaticResource Box}"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource Ghost}"
                            Margin="8,0,0,0"/>
                    <Button x:Name="TestSoundButton" Grid.Column="2" Style="{StaticResource Ghost}"
                            Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="HintSound" Style="{StaticResource Hint}"/>

                <TextBlock x:Name="SecSystem" Style="{StaticResource H}"/>
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}"/>
                <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FF101216" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <Button x:Name="PreviewButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
